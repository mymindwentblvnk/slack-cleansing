# Copy to `.env` and fill in your values. Never commit `.env`.
# Required:
SLACK_WORKSPACE=my-workspace
SLACK_TOKEN=xoxc-...
SLACK_COOKIE_D=xoxd-...

# Default channel for `scan` (can still be overridden with --channel):
SLACK_CHANNEL=my-channel

# Optional: default --since for scan (local date, ISO datetime, or Slack ts):
# SLACK_SINCE=2024-01-15
