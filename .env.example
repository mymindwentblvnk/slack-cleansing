# Copy to `.env` and fill in your values. Never commit `.env`.
# Required:
SLACK_WORKSPACE=my-workspace
SLACK_TOKEN=xoxc-...
SLACK_COOKIE_D=xoxd-...

# Optional: default --since for scan (local date, ISO datetime, or Slack ts):
# SLACK_SINCE=2024-01-15

# Optional: default --till for scan / delete; only messages before
# this (same formats, or N days ago like 30d to keep the last 30 days):
# SLACK_TILL=30d
